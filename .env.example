# ---- Copy to .env and edit. Every setting is optional. ----

# Your public URL(s). Blocks other websites from connecting to your chat.
ALLOWED_ORIGINS=https://chat.example.com
# Set to 1 ONLY when running behind Cloudflare / Caddy / nginx (uses real visitor IPs for limits)
TRUST_PROXY=1

# ---- Branding ----
SITE_NAME=OpenTalk
SITE_TAGLINE=Free & open. No sign-up, no login. Messages aren't saved.
GITHUB_URL=https://github.com/OneByJorah/opentalk

# ---- Moderation ----
# Long random string. In chat, type: /admin <key>   (generate: openssl rand -hex 24)
ADMIN_KEY=
BAN_HOURS=24
# Extra blocked words, comma separated (also reads blocked-words.txt)
BLOCKED_WORDS=
# Allow links in the public lobby? (private rooms always allow them)
LOBBY_LINKS=0
# Turn the public lobby off entirely (private rooms only)
ENABLE_LOBBY=1
# Show new lobby joiners the last 50 messages
LOBBY_HISTORY=1

# ---- Limits ----
MAX_CONN_PER_IP=5
MAX_ROOMS=1000
MAX_PRIVATE_ROOM_SIZE=50
MAX_LOBBY_SIZE=500

# ---- Money (see MONETIZATION.md) ----
# Donation button: Ko-fi, Buy Me a Coffee, GitHub Sponsors, or a Stripe Payment Link
DONATE_URL=
DONATE_LABEL=☕ Support this chat
# Self-hosted sponsor banner — sell this spot directly (no trackers, no ad network)
SPONSOR_TEXT=
SPONSOR_URL=
# Google AdSense (leave empty to disable — no Google scripts load unless set)
ADSENSE_CLIENT=
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_CHAT=
